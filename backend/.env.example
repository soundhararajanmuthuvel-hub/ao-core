# ==========================================
# AO Core ERP - Environment Variables
# ==========================================

# 1. SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# 2. DATABASE CONFIGURATION (Required in Production)
DATABASE_URL=mysql://root:password@localhost:3306/ao_core
# Or alternatively, individual variables:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ao_core
DB_DIALECT=mysql

# 3. SECURITY & AUTHENTICATION (CRITICAL)
# Generate a secure 32-byte hex string using: openssl rand -hex 32
JWT_SECRET=your_generated_jwt_secret_here
# Generate a secure 32-byte hex string using: openssl rand -hex 32
ENCRYPTION_KEY=your_generated_encryption_key_here

# 4. URLS & NETWORKING (CORS)
CLIENT_URL=https://YOUR_VERCEL_URL.vercel.app
BLOVIT_FRONTEND_URL=https://YOUR_STOREFRONT_URL.vercel.app
SERVER_URL=https://YOUR_RENDER_URL.onrender.com

# 5. CLOUDINARY (Required for Media)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
# Or alternatively:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# 6. RAZORPAY (Required for Production Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 7. EXTERNAL API KEYS
WEBSITE_API_KEY=your_secure_website_api_key
BLO_WEBSITE_API_KEY=your_secure_blo_website_api_key
STOREFRONT_API_KEY=your_secure_storefront_api_key
CRM_SEED_API_KEY=your_crm_seed_api_key_here

# 8. AI INTEGRATIONS (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
